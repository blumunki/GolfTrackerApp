@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<ApplicationDbContext> ContextFactory
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject IClubMembershipService ClubMembershipService
@inject ILogger<UserManagement> Logger

@rendermode InteractiveServer

<PageTitle>User Management</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Class="mr-2" />
    User Management
</MudText>

<MudButton Href="admin" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-3">
    Back to Admin Dashboard
</MudButton>

@if (loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @* ===== Search & Filter ===== *@
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="6" md="4">
            <MudTextField @bind-Value="searchTerm" Label="Search by email" Variant="Variant.Outlined"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                          OnKeyDown="@HandleSearchKeyDown" Immediate="false" />
        </MudItem>
        <MudItem xs="12" sm="3" md="2">
            <MudSelect @bind-Value="roleFilter" Label="Role" Variant="Variant.Outlined">
                <MudSelectItem Value="@("All")">All</MudSelectItem>
                <MudSelectItem Value="@("Admin")">Admin</MudSelectItem>
                <MudSelectItem Value="@("User")">User</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3" md="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadUsers" Class="mt-1"
                       StartIcon="@Icons.Material.Filled.Search">
                Search
            </MudButton>
        </MudItem>
    </MudGrid>

    @* ===== Users Table ===== *@
    <MudCard Elevation="2" Class="mb-4">
        <MudCardContent>
            <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mb-2">
                Showing @filteredUsers.Count of @totalUserCount users
            </MudText>
            <MudSimpleTable Dense="true" Hover="true" Bordered="true">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Linked Player</th>
                        <th>Role</th>
                        <th>Club Admin</th>
                        <th>AI Opted Out</th>
                        <th>Email Confirmed</th>
                        <th style="width: 320px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!filteredUsers.Any())
                    {
                        <tr>
                            <td colspan="7" style="text-align: center;">
                                <MudText Typo="Typo.body2" Color="Color.Tertiary">No users found.</MudText>
                            </td>
                        </tr>
                    }
                    @foreach (var user in filteredUsers)
                    {
                        <tr>
                            <td>@user.Email</td>
                            <td>@(user.LinkedPlayerName ?? "—")</td>
                            <td>
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(user.Role == "Admin" ? Color.Error : Color.Default)">
                                    @user.Role
                                </MudChip>
                            </td>
                            <td>
                                @if (user.ClubAdminNames.Count == 0)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Tertiary">None</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption">@string.Join(", ", user.ClubAdminNames)</MudText>
                                }
                            </td>
                            <td>
                                @if (user.AiInsightsOptOut)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.DoNotDisturb" Color="Color.Error" Size="Size.Small" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                                }
                            </td>
                            <td>
                                @if (user.EmailConfirmed)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Verified" Color="Color.Success" Size="Size.Small" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" />
                                }
                            </td>
                            <td>
                                <MudStack Row="true" Spacing="1">
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                               OnClick="@(() => OpenClubAdminDialog(user))"
                                               StartIcon="@Icons.Material.Filled.GolfCourse">
                                        Club Access
                                    </MudButton>
                                    @if (user.Role != "Admin")
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                                   OnClick="@(() => PromoteToAdmin(user))"
                                                   StartIcon="@Icons.Material.Filled.ArrowUpward">
                                            Make Admin
                                        </MudButton>
                                    }
                                    else if (user.UserId != currentAdminId)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                                                   OnClick="@(() => DemoteFromAdmin(user))"
                                                   StartIcon="@Icons.Material.Filled.ArrowDownward">
                                            Remove Admin
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Tertiary">Current user</MudText>
                                    }
                                </MudStack>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudCardContent>
    </MudCard>

    @* ===== Status Messages ===== *@
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <MudAlert Severity="@statusSeverity" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="@(() => statusMessage = null)">
            @statusMessage
        </MudAlert>
    }
}

<MudDialog @bind-Visible="showClubAdminDialog"
           Options="@(new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small })">
    <TitleContent>
        <MudText Typo="Typo.h6">Club Admin Access</MudText>
    </TitleContent>
    <DialogContent>
        @if (editingClubAdminUser is not null)
        {
            <MudText Typo="Typo.body2" Class="mb-3">
                Choose the clubs that <strong>@editingClubAdminUser.Email</strong> may administer.
                Only a global admin can grant this access.
            </MudText>
            @if (clubs.Count == 0)
            {
                <MudAlert Severity="Severity.Info">No golf clubs are available.</MudAlert>
            }
            else
            {
                <MudStack Spacing="1">
                    @foreach (var club in clubs)
                    {
                        <MudCheckBox T="bool"
                                     Value="@selectedClubAdminIds.Contains(club.GolfClubId)"
                                     ValueChanged="@(selected => SetClubSelection(club.GolfClubId, selected))"
                                     Label="@club.Name"
                                     Color="Color.Primary" />
                    }
                </MudStack>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3">
                    Removing club-admin access keeps the user's ordinary club membership.
                </MudText>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseClubAdminDialog" Disabled="@savingClubAdmins">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="SaveClubAdminAccess" Disabled="@(savingClubAdmins || clubs.Count == 0)">
            @(savingClubAdmins ? "Saving..." : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool loading = true;
    private string searchTerm = string.Empty;
    private string roleFilter = "All";
    private string? statusMessage;
    private Severity statusSeverity = Severity.Info;
    private string? currentAdminId;
    private int totalUserCount;
    private bool showClubAdminDialog;
    private bool savingClubAdmins;
    private UserViewModel? editingClubAdminUser;
    private HashSet<int> selectedClubAdminIds = new();

    private List<UserViewModel> filteredUsers = new();
    private List<GolfClub> clubs = new();

    protected override async Task OnInitializedAsync()
    {
        // Get current admin user ID
        var users = UserManager.Users;
        await LoadUsers();
        loading = false;
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadUsers();
        }
    }

    private async Task LoadUsers()
    {
        try
        {
            await using var context = await ContextFactory.CreateDbContextAsync();

            var query = context.Users
                .Include(u => u.LinkedPlayer)
                .Include(u => u.ClubMemberships)
                    .ThenInclude(cm => cm.GolfClub)
                .AsNoTracking()
                .AsQueryable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim().ToLower();
                query = query.Where(u => u.Email != null && u.Email.ToLower().Contains(term));
            }

            totalUserCount = await context.Users.CountAsync();
            var allUsers = await query.OrderBy(u => u.Email).Take(100).ToListAsync();
            clubs = await context.GolfClubs
                .AsNoTracking()
                .OrderBy(c => c.Name)
                .ToListAsync();

            // Get all admin user IDs
            var adminRole = await context.Roles.FirstOrDefaultAsync(r => r.Name == "Admin");
            var adminUserIds = new HashSet<string>();
            if (adminRole != null)
            {
                adminUserIds = (await context.UserRoles
                    .Where(ur => ur.RoleId == adminRole.Id)
                    .Select(ur => ur.UserId)
                    .ToListAsync())
                    .ToHashSet();
            }

            // Determine current admin
            var authState = await GetAuthenticationState();
            currentAdminId = authState?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            filteredUsers = allUsers.Select(u => new UserViewModel
            {
                UserId = u.Id,
                Email = u.Email ?? "Unknown",
                LinkedPlayerName = u.LinkedPlayer != null ? $"{u.LinkedPlayer.FirstName} {u.LinkedPlayer.LastName}" : null,
                Role = adminUserIds.Contains(u.Id) ? "Admin" : "User",
                AiInsightsOptOut = u.AiInsightsOptOut,
                EmailConfirmed = u.EmailConfirmed,
                ClubAdminIds = u.ClubMemberships
                    .Where(cm => cm.Role == MembershipRole.Admin)
                    .Select(cm => cm.GolfClubId)
                    .ToHashSet(),
                ClubAdminNames = u.ClubMemberships
                    .Where(cm => cm.Role == MembershipRole.Admin && cm.GolfClub != null)
                    .Select(cm => cm.GolfClub!.Name)
                    .OrderBy(name => name)
                    .ToList(),
            }).ToList();

            // Apply role filter
            if (roleFilter != "All")
            {
                filteredUsers = filteredUsers.Where(u => u.Role == roleFilter).ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading users");
            statusMessage = "Error loading users.";
            statusSeverity = Severity.Error;
        }
    }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private async Task<System.Security.Claims.ClaimsPrincipal?> GetAuthenticationState()
    {
        if (AuthenticationStateTask == null) return null;
        var state = await AuthenticationStateTask;
        return state.User;
    }

    private async Task PromoteToAdmin(UserViewModel userVm)
    {
        var user = await UserManager.FindByIdAsync(userVm.UserId);
        if (user == null) return;

        var result = await UserManager.AddToRoleAsync(user, "Admin");
        if (result.Succeeded)
        {
            statusMessage = $"{user.Email} promoted to Admin.";
            statusSeverity = Severity.Success;
            userVm.Role = "Admin";
        }
        else
        {
            statusMessage = $"Failed to promote: {string.Join(", ", result.Errors.Select(e => e.Description))}";
            statusSeverity = Severity.Error;
        }
    }

    private async Task DemoteFromAdmin(UserViewModel userVm)
    {
        var user = await UserManager.FindByIdAsync(userVm.UserId);
        if (user == null) return;

        var result = await UserManager.RemoveFromRoleAsync(user, "Admin");
        if (result.Succeeded)
        {
            statusMessage = $"{user.Email} demoted to User.";
            statusSeverity = Severity.Success;
            userVm.Role = "User";
        }
        else
        {
            statusMessage = $"Failed to demote: {string.Join(", ", result.Errors.Select(e => e.Description))}";
            statusSeverity = Severity.Error;
        }
    }

    private void OpenClubAdminDialog(UserViewModel userVm)
    {
        editingClubAdminUser = userVm;
        selectedClubAdminIds = userVm.ClubAdminIds.ToHashSet();
        showClubAdminDialog = true;
    }

    private void CloseClubAdminDialog()
    {
        showClubAdminDialog = false;
        editingClubAdminUser = null;
        selectedClubAdminIds.Clear();
    }

    private void SetClubSelection(int clubId, bool selected)
    {
        if (selected)
            selectedClubAdminIds.Add(clubId);
        else
            selectedClubAdminIds.Remove(clubId);
    }

    private async Task SaveClubAdminAccess()
    {
        if (editingClubAdminUser is null) return;
        var user = editingClubAdminUser;

        savingClubAdmins = true;
        try
        {
            var existingIds = user.ClubAdminIds;
            var changedClubIds = existingIds
                .Where(id => !selectedClubAdminIds.Contains(id))
                .Concat(selectedClubAdminIds.Where(id => !existingIds.Contains(id)))
                .ToList();

            foreach (var clubId in changedClubIds)
            {
                await ClubMembershipService.SetClubAdminAsync(
                    clubId,
                    user.UserId,
                    selectedClubAdminIds.Contains(clubId));
            }

            statusMessage = $"Club-admin access updated for {user.Email}.";
            statusSeverity = Severity.Success;
            showClubAdminDialog = false;
            editingClubAdminUser = null;
            await LoadUsers();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating club-admin access for user {UserId}", user.UserId);
            statusMessage = "Failed to update club-admin access.";
            statusSeverity = Severity.Error;
        }
        finally
        {
            savingClubAdmins = false;
        }
    }

    private class UserViewModel
    {
        public string UserId { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? LinkedPlayerName { get; set; }
        public string Role { get; set; } = "User";
        public bool AiInsightsOptOut { get; set; }
        public bool EmailConfirmed { get; set; }
        public HashSet<int> ClubAdminIds { get; set; } = new();
        public List<string> ClubAdminNames { get; set; } = new();
    }
}
